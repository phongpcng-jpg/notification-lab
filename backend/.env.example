PORT=3000
DB_PATH=./data/notification-lab.db

# Long polling: thời gian server giữ request mở tối đa trước khi trả timeout
LONG_POLL_TIMEOUT_MS=25000

# Short polling: chỉ là gợi ý cho client, client có thể tự cấu hình khác
SHORT_POLL_INTERVAL_MS=5000

# SSE heartbeat — gửi comment `: ping` định kỳ để tránh proxy buffer/timeout kết nối
SSE_HEARTBEAT_MS=15000

# WebSocket ping/pong heartbeat để phát hiện stale connection
WS_HEARTBEAT_MS=20000

# Web Push — sinh VAPID key bằng: npx web-push generate-vapid-keys
# KHÔNG commit key thật vào git.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# CORS — origin của frontend dev server (Vite mặc định 5173)
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info
